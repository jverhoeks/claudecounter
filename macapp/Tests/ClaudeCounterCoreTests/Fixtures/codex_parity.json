{
  "_comment": "Shared verbatim with tui/internal/agg/codex_parity_test.go and macapp/Tests/ClaudeCounterCoreTests/CodexParityTests.swift, per the grouping_parity/costed_parity precedent: one fixture, no Go-side copy. Unlike those two, this one drives the real Aggregator/apply+Snapshot(snapshot) path end to end rather than feeding pre-summed usd into Group() directly — Codex is priced, not costed, so the interesting behavior (the pricing table, and codex-auto-review's alias to gpt-5.6-luna) only fires if each language's own pricing lookup actually runs. The pricing table below intentionally has a row for gpt-5.6-luna but none for codex-auto-review itself, so a non-zero codex-auto-review cost is only reachable through the alias — see pricing.aliasedModel (Go) / aliasedModel (Swift). Every expected figure is hand-computed from the events below; see the task-6 report for the arithmetic.",

  "now": {"year": 2026, "month": 8, "day": 16, "hour": 12},

  "pricing": {
    "gpt-5.6-sol":  {"input": 1.50, "output": 6.00, "cacheCreate": 0,    "cacheRead": 0.15},
    "gpt-5.6-luna": {"input": 0.20, "output": 1.20, "cacheCreate": 0,    "cacheRead": 0.02}
  },

  "events": [
    {"msgID": "codex-e1", "reqID": "r1", "source": "codex/work",     "project": "proj-a", "model": "gpt-5.6-sol",       "dayOffset": 0,  "input": 12000000, "output": 2000000, "cacheCreate": 0, "cacheRead": 0},
    {"msgID": "codex-e2", "reqID": "r2", "source": "codex/personal", "project": "proj-b", "model": "gpt-5.6-sol",       "dayOffset": -1, "input": 4000000,  "output": 1000000, "cacheCreate": 0, "cacheRead": 20000000},
